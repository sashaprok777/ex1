import numpy as np

class Detector:
    def __init__(self, R=2.0, N=40, r=0.1, a=0.5):
        self.R = R
        self.N = N
        self.r = r
        self.a = a
        
        # Точки равномерно по поверхности сферы
        z = np.random.uniform(-self.R, self.R, N)
        phi = np.random.uniform(0, 2 * np.pi, N)
        
        # Радиус окружности в сечении
        r_xy = np.sqrt(self.R**2 - z**2)
        
        self.pmt_coords = np.zeros((N, 3))
        self.pmt_coords[:, 0] = r_xy * np.cos(phi)
        self.pmt_coords[:, 1] = r_xy * np.sin(phi)
        self.pmt_coords[:, 2] = z

    def check_hit(self, origin, direction):
        ox, oy, oz = origin
        dx, dy, dz = direction
        """
        # Уравнение сферы: x^2 + y^2 + z^2 = R^2
        # (ox + t*dx)^2 + (oy + t*dy)^2 + (oz + t*dz)^2 = R^2
        # A*t^2 + B*t + C = 0
        """
        A = dx**2 + dy**2 + dz**2 
        B = 2 * (ox * dx + oy * dy + oz * dz)
        C = ox**2 + oy**2 + oz**2 - self.R**2
        
        discriminant = B**2 - 4 * A * C
        if discriminant < 0:
            return -1 # Луч прошел мимо
            
        t1 = (-B - np.sqrt(discriminant)) / (2 * A)
        t2 = (-B + np.sqrt(discriminant)) / (2 * A)
        
        t = min([t for t in [t1, t2] if t > 0], default=-1)
        
        if t < 0:
            return -1
            
        # Точка пересечения луча со сферой
        hit_point = np.array([ox + t*dx, oy + t*dy, oz + t*dz])
        
        # Ближайший ФЭУ 
        distances = np.linalg.norm(self.pmt_coords - hit_point, axis=1)
        closest_idx = np.argmin(distances)
        
        if distances[closest_idx] <= self.r:
            return closest_idx
        return -1
